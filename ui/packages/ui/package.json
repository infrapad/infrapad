{
  "name": "@infrapad/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@patternfly/react-core": "^6.5.1",
    "@patternfly/react-data-view": "^6.6.0-prerelease.1",
    "@patternfly/react-charts": "^8.5.1",
    "@patternfly/react-icons": "^6.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.5",
    "victory": "^37.3.6"
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "js-yaml": "^4.1.0",
    "marked": "^14.0.0",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@patternfly/react-core": "^6.6.1",
    "@patternfly/react-data-view": "^6.6.0-prerelease.1",
    "@patternfly/react-charts": "^8.5.1",
    "@patternfly/react-icons": "^6.4.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "vitest": "^4.0.18",
    "victory": "^37.3.6"
  }
}
