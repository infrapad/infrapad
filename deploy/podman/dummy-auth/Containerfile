FROM docker.io/library/golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod main.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/dummy-auth .

FROM scratch
COPY --from=build --chown=65532:65532 /out/dummy-auth /dummy-auth
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/dummy-auth"]
CMD ["proxy"]
